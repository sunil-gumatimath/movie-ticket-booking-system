{
  "apiEndpoints": [
    {
      "priority": 1,
      "step": "User Registration",
      "method": "POST",
      "path": "/register",
      "description": "Register a new user account. Public registration always creates ROLE_USER.",
      "authentication": "None",
      "sampleRequest": {
        "username": "john_doe123",
        "email": "john.doe@gmail.com",
        "phoneNumber": "9876543210",
        "password": "Password123!",
        "dateOfBirth": "1990-05-15"
      },
      "queryParams": [],
      "pathParams": []
    },
    {
      "priority": 2,
      "step": "User Login",
      "method": "POST",
      "path": "/login",
      "description": "Authenticate a user and get a JWT token.",
      "authentication": "None",
      "sampleRequest": {
        "email": "john.doe@gmail.com",
        "password": "Password123!"
      },
      "queryParams": [],
      "pathParams": []
    },
    {
      "priority": 3,
      "step": "Update User Profile",
      "method": "PUT",
      "path": "/update",
      "description": "Update a user profile. The authenticated user must be the target user or have ROLE_ADMIN.",
      "authentication": "JWT Token for the target user or ROLE_ADMIN",
      "sampleRequest": {
        "username": "john_doe_updated",
        "phoneNumber": "9876543210",
        "dateOfBirth": "1990-05-15"
      },
      "queryParams": [
        {
          "name": "email",
          "value": "john.doe@gmail.com",
          "description": "Target user's email address"
        }
      ],
      "pathParams": []
    },
    {
      "priority": 4,
      "step": "Soft Delete User",
      "method": "DELETE",
      "path": "/delete",
      "description": "Soft delete a user account. The authenticated user must be the target user or have ROLE_ADMIN.",
      "authentication": "JWT Token for the target user or ROLE_ADMIN",
      "sampleRequest": null,
      "queryParams": [
        {
          "name": "email",
          "value": "john.doe@gmail.com",
          "description": "Target user's email address"
        }
      ],
      "pathParams": []
    },
    {
      "priority": 5,
      "step": "Register Theater",
      "method": "POST",
      "path": "/theater/register",
      "description": "Register a theater for the authenticated theater owner.",
      "authentication": "JWT Token with ROLE_THEATER_OWNER",
      "sampleRequest": {
        "name": "PVR Cinemas",
        "address": "123 Main Street",
        "city": "Bangalore",
        "landmark": "Near Central Mall"
      },
      "queryParams": [],
      "pathParams": []
    },
    {
      "priority": 6,
      "step": "Get Theater Details",
      "method": "GET",
      "path": "/theater/{id}",
      "description": "Get theater details by ID.",
      "authentication": "JWT Token",
      "sampleRequest": null,
      "queryParams": [],
      "pathParams": [
        {
          "name": "id",
          "value": "theater-123",
          "description": "Theater ID"
        }
      ]
    },
    {
      "priority": 7,
      "step": "Update Theater",
      "method": "PUT",
      "path": "/theater/{id}",
      "description": "Update theater details. The theater must belong to the authenticated owner.",
      "authentication": "JWT Token with ROLE_THEATER_OWNER and theater ownership",
      "sampleRequest": {
        "name": "PVR Cinemas - Updated",
        "address": "456 New Street",
        "city": "Bangalore",
        "landmark": "Near Airport"
      },
      "queryParams": [],
      "pathParams": [
        {
          "name": "id",
          "value": "theater-123",
          "description": "Theater ID"
        }
      ]
    },
    {
      "priority": 8,
      "step": "Add Screen to Theater",
      "method": "POST",
      "path": "/screen",
      "description": "Add a screen to a theater owned by the authenticated user. A seat layout is generated.",
      "authentication": "JWT Token with ROLE_THEATER_OWNER and theater ownership",
      "sampleRequest": {
        "screenType": "THREE_D",
        "capacity": 150,
        "noOfRows": 10
      },
      "queryParams": [
        {
          "name": "theaterId",
          "value": "theater-123",
          "description": "Theater ID"
        }
      ],
      "pathParams": []
    },
    {
      "priority": 9,
      "step": "Get Screen Details",
      "method": "GET",
      "path": "/screen/{screenId}",
      "description": "Get screen details, including its generated seat layout, by ID.",
      "authentication": "JWT Token",
      "sampleRequest": null,
      "queryParams": [],
      "pathParams": [
        {
          "name": "screenId",
          "value": "screen-456",
          "description": "Screen ID"
        }
      ]
    },
