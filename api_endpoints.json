      "authentication": "JWT Token with ROLE_ADMIN",
      "sampleRequest": {
        "title": "Example Movie",
        "description": "A movie description.",
        "runtime": "PT2H",
        "certificate": "UA",
        "genre": "DRAMA",
        "castList": [
          "Actor One",
          "Actor Two"
        ]
      },
      "queryParams": [],
      "pathParams": []
    },
    {
