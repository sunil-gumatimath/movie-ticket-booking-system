      "path": "/theaters/{theaterId}/screens/{screenId}/shows",
      "description": "Add a show to an owned screen. The movie must exist and shows may not overlap.",
      "authentication": "JWT Token with ROLE_THEATER_OWNER, theater ownership, and screen ownership",
      "sampleRequest": {
        "startTimeEpochMillis": 1735094400000,
        "movieId": "movie-789"
      },
      "queryParams": [],
      "pathParams": [
        {
          "name": "theaterId",
          "value": "theater-123",
          "description": "Theater ID"
        },
        {
          "name": "screenId",
          "value": "screen-456",
          "description": "Screen ID"
        }
      ]
    },
