                             "step":  "Update User Profile",
                             "method":  "PUT",
                             "path":  "/users/{userId}",
                             "description":  "Update a user profile. The authenticated user must be the target user or have ROLE_ADMIN.",
                             "authentication":  "JWT Token for the target user or ROLE_ADMIN",
                             "sampleRequest":  {
                                                   "username":  "john_doe_updated",
                                                   "phoneNumber":  "9876543210",
                                                   "dateOfBirth":  "1990-05-15"
                                               },
                             "queryParams":  [

                                             ],
                             "pathParams":  [
                                                {
                                                    "name":  "userId",
                                                    "value":  "uuid-string",
                                                    "description":  "Target user\u0027s ID (returned by POST /register and in the login JWT userId claim)"
                                                }
                                            ],
                             "endpointNumber":  3,
                             "requestContentType":  "application/json",
                             "responseContentType":  "application/json",
                             "successStatus":  200
                         },
